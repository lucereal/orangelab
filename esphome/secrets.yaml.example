# Copy to secrets.yaml (gitignored). Fill in. Do not commit the real file.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Home Assistant host as seen from the ESP32. Use a LAN IP.
# .local names often fail on Windows and on the ESP. Not "core-mosquitto".
mqtt_broker: "192.168.1.50"
mqtt_username: "YOUR_MQTT_USERNAME"
mqtt_password: "YOUR_MQTT_PASSWORD"

# openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_32_BYTES"
ota_password: "YOUR_OTA_PASSWORD"
