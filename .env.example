# Home Assistant long-lived access token (REST path only: serial / HTTP adapters)
HOME_LAB_TOKEN=

# MQTT broker used by mqtt_listener.py and ha/mqtt_publisher.py
MQTT_BROKER=YOUR_MQTT_BROKER_HOST
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Default scanner_id when a scan payload omits it
SCANNER_ID=1

# Optional: light entity for the REST preset helper (makeconnection.py)
HA_LIGHT_ENTITY=light.your_lamp
